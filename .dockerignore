# Keep the build context small and free of local state. The Dockerfile needs only
# pyproject.toml, uv.lock, LICENSE, README.md (if present) and src/.
.git
.github
.venv
.env
.m3
.superpowers
.agents
.claude
.ruff_cache
.pytest_cache
.mypy_cache
**/__pycache__
**/*.pyc
*.egg-info
dist
reports
m3_tests
docs
scripts
.DS_Store
