# keyless-mcp needs NO API keys. `make test` runs fully offline and needs nothing here.
# Everything below is optional; copy this file to .env to use any of it.

# How upstream HTTP is performed: live (default) | record | replay
# KEYLESS_MCP_HTTP_MODE=live

# Directory of JSON cassettes used by record and replay modes.
# KEYLESS_MCP_CASSETTE_DIR=m3_tests/adapters/arxiv/cassettes

# Comma-separated toolsets to serve (science, dev, geo, news, finance, reference, fun). Default: all.
# KEYLESS_MCP_TOOLSETS=science,dev

# Only for the real-agent tests (`make agent`, marked `agent`; never run by `make test`).
# `m3 test` loads this file automatically when it is saved as .env in the project root.
# Set the credential for the harness you pick; docs/agent-testing.md has the details.
#
#   Claude Code (make agent HARNESS=claude MODEL=sonnet):
#     M3 runs Claude Code in an isolated HOME, so your `claude` login is NOT used. It needs a key:
# ANTHROPIC_API_KEY=
#     or a subscription token from `claude setup-token`, mapped with M3_ARGS:
#       CLAUDE_CODE_OAUTH_TOKEN=...  and  make agent ... M3_ARGS="--credential-env claude:CLAUDE_CODE_OAUTH_TOKEN=CLAUDE_CODE_OAUTH_TOKEN"
#
#   Codex (make agent HARNESS=codex MODEL=<model id>):
#     reuses your `codex login` (ChatGPT) automatically, or set a key:
# OPENAI_API_KEY=
#
#   OpenCode / Pi: pick MODEL as provider/model (for example anthropic/<model>) and set that
#   provider's key (ANTHROPIC_API_KEY, OPENAI_API_KEY or OPENCODE_API_KEY).

# Optional: only for M3 LLM judges, which keyless-mcp's tests do not use today.
# M3_JUDGE_API_KEY=
