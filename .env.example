# keyless-mcp needs NO API keys. `make test` runs fully offline and needs nothing here.
# Everything below is optional; copy this file to .env to use any of it.

# How upstream HTTP is performed: live (default) | record | replay
# KEYLESS_MCP_HTTP_MODE=live

# Directory of JSON cassettes used by record and replay modes.
# KEYLESS_MCP_CASSETTE_DIR=m3_tests/adapters/arxiv/cassettes

# Comma-separated toolsets to serve (science, dev, geo, news). Default: all.
# KEYLESS_MCP_TOOLSETS=science,dev

# Only for M3 agent tests (marked `agent`, never run by `make test`):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# M3_JUDGE_API_KEY=
